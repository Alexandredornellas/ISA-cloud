# Copy to .env for local development. Never commit .env.

DATABASE_URL=postgres://isa:isa@localhost:5432/isa

# Password for the ISA web app (single user for the prototype).
ISA_PASSWORD=change-me

# Anthropic
ANTHROPIC_API_KEY=

# Jira Cloud
JIRA_SITE=yourname.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=ISA

# Recall.ai meeting bot (region of your Recall account: us-east-1, us-west-2, eu-central-1, ap-northeast-1)
RECALL_API_KEY=
RECALL_REGION=us-east-1

# Set to "off" to stop the background worker (polls meeting bots, sorts new items every 10 s)
ISA_WORKER=

# Slack: create the app from docs/slack-app-manifest.json, install it, then copy both tokens.
# ISA reads with the user token (xoxp-) and posts as the "ISA" bot (xoxb-).
SLACK_USER_TOKEN=
SLACK_BOT_TOKEN=
